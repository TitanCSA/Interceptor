<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Interceptor · Installation and diagnostics" Width="1360" Height="940" MinWidth="1050" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" Foreground="#152B49">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#173556"/><Setter Property="BorderBrush" Value="#D5DFEC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="BorderBrush" Value="#E4EAF3"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#61758E"/></Style>
  <Style TargetType="DataGrid"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9FC"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="30"/><Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
 </Window.Resources>
 <Grid Margin="26,20,26,18">
  <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="103"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" Background="#1464E8" CornerRadius="13" VerticalAlignment="Top" Margin="0,0,13,0"><TextBlock Text="I" Foreground="#FFE365" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="Interceptor" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Installation, devices and diagnostics in one place" Style="{StaticResource Caption}"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#FFF0AD" CornerRadius="15" Padding="15,7" VerticalAlignment="Top"><TextBlock Name="PackageEdition" Text="INTERCEPTOR · WINDOWS 10 / 11" FontSize="11" FontWeight="SemiBold" Foreground="#68520D"/></Border></Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,11"><StackPanel><TextBlock Text="DRIVER" Style="{StaticResource Caption}"/><TextBlock Name="DriverState" Text="Checking…" FontSize="21" FontWeight="SemiBold" Margin="0,3"/><TextBlock Name="DriverDetail" Text="Windows service status" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,11"><StackPanel><TextBlock Text="API &amp; QUEUES" Style="{StaticResource Caption}"/><TextBlock Name="ApiState" Text="Checking…" FontSize="21" FontWeight="SemiBold" Margin="0,3"/><TextBlock Name="ApiDetail" Text="Reading API status" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,11"><StackPanel><TextBlock Text="CONNECTED DEVICES" Style="{StaticResource Caption}"/><TextBlock Name="DeviceCount" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,3"/><TextBlock Name="DeviceSummary" Text="Refreshes automatically when devices connect" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,0,0,16"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Name="InstallButton" Content="↻  Install / reinstall" Background="#1464E8" Foreground="White" BorderBrush="#1464E8" MinWidth="152"/><Button Name="UninstallButton" Content="Uninstall"/><Button Name="AssociateButton" Content="Associate new devices"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="DiagnosticButton" Content="Diagnose" Background="#1464E8" Foreground="White" BorderBrush="#1464E8"/><Button Name="RefreshButton" Content="Refresh"/><Button Name="ExportButton" Content="Export diagnostics" Margin="0"/></StackPanel></DockPanel>
   <Border Background="#E9F0FF" CornerRadius="9" Margin="0,10,0,0" Padding="13,9"><DockPanel><Button Name="RebootButton" Content="Restart" Visibility="Collapsed" DockPanel.Dock="Right" Padding="12,5"/><StackPanel><TextBlock Name="Phase" Text="Ready. Read-only inventory; run a quick diagnostic when needed." FontWeight="SemiBold" FontSize="13"/><TextBlock Name="Hint" Text="Checking the package. Windows never restarts automatically." Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/><ProgressBar Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,9,0,0" Foreground="#1464E8" Background="#CFDDF8" BorderThickness="0"/></StackPanel></DockPanel></Border>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="3,0,0,10"><TextBlock Text="Detected devices" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Associated = configured in Windows. Interface = driver present; capture still depends on the device profile." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel>
    <DataGrid Name="Devices" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95"/><DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*" MinWidth="140"/><DataGridTextColumn Header="VID : PID" Binding="{Binding VidPid}" Width="86"/><DataGridTextColumn Header="Interceptor" Binding="{Binding Association}" Width="140"/><DataGridTextColumn Header="Windows service" Binding="{Binding ServiceDisplay}" Width="145"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Background="#F2F5FA" CornerRadius="7" Padding="10" Margin="0,8,0,0"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock Name="DeviceDetail" Text="Select a row to view its role, identity and Windows status." FontSize="11" Foreground="#52677F" TextWrapping="Wrap"/></ScrollViewer></Border>
   </Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="15">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Check &amp; measure" FontSize="17" FontWeight="SemiBold"/><TextBlock Name="EnvironmentState" Text="Checking Windows and the package…" FontSize="11" Foreground="#61758E" TextWrapping="Wrap" Margin="0,4,0,6"/></StackPanel>
     <StackPanel Grid.Row="1"><Button Name="BenchmarkButton" Content="Measure API latency" Padding="10,7" Margin="0,0,0,5"/><Button Name="InputButton" Content="Observe input · 10 s" Padding="10,7" Margin="0,0,0,8"/></StackPanel>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <DockPanel><TextBlock Name="Latency" Text="— µs" FontSize="22" Foreground="#1464E8" FontWeight="SemiBold"/><TextBlock Text="API round trip" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Name="LatencyDetail" Text="1,000 STATUS requests. Measures software/kernel time, excluding hardware latency." FontSize="11" Foreground="#61758E" TextWrapping="Wrap" Margin="0,2,0,8"/>
      <Border Background="#E4EAF3" Height="1" Margin="0,0,0,7"/>
      <DockPanel><TextBlock Name="InputCount" Text="0 events" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Raw Input" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Name="InputState" Text="Observe for 10 seconds without blocking input." FontSize="11" Foreground="#61758E" TextWrapping="Wrap" Margin="0,3,0,3"/>
      <TextBlock Name="InputDetail" Text="Use a device during the observation." FontFamily="Consolas" FontSize="11" Foreground="#61758E" TextWrapping="Wrap" MaxHeight="36"/>
      <TextBlock Text="Windows observation does not prove driver capture." ToolTip="Native Xbox interfaces may not publish Raw Input." FontSize="11" Foreground="#61758E" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="4" Background="#122A48" CornerRadius="12" Padding="15,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,7"><TextBlock Text="LOG" Foreground="#FFE365" FontSize="11" FontWeight="SemiBold"/><TextBlock Name="LogPath" Text="Detailed output is included in exported diagnostics" Foreground="#9BB2CE" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBox Name="Log" Grid.Row="1" Background="Transparent" Foreground="#E3EEFF" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
  <DockPanel Grid.Row="5" Margin="2,9,2,0"><TextBlock Text="Ctrl + Alt + Delete releases capture contexts." Style="{StaticResource Caption}"/><TextBlock Name="BuildLabel" Text="Windows x64 · diagnostics on demand" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>
