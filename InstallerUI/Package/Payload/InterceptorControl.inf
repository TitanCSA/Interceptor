[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=InterceptorControl.cat
DriverVer=10/23/2026,1.4.21.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299
[Models.NTamd64.10.0...16299]
%Name%=Control,ROOT\InterceptorControl
[Control.NT]
CopyFiles=Files
[Control.NT.Services]
AddService=Interceptor,2,Service
AddService=InterceptorDemoClock,0,TrialClockService
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\Interceptor.sys
[Control.NT.Wdf]
KmdfService=Interceptor,Wdf
[Wdf]
KmdfLibraryVersion=1.15
[DestinationDirs]
Files=13
[Files]
TitanDemoClock.sys
Interceptor.sys
[SourceDisksNames]
1=%Provider%,,,
[SourceDisksFiles]
TitanDemoClock.sys=1
Interceptor.sys=1
[Strings]
Provider="Interceptor Project"
Name="Interceptor Control Endpoint"
ServiceName="Interceptor"

[TrialClockService]
DisplayName="TitanCSA per-boot demo clock"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TitanDemoClock.sys
